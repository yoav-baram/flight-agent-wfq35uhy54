# ntfy topic (from https://ntfy.sh or your self-hosted server) for price-alert push notifications
NTFY_TOPIC=your_private_topic_name_here

# Optional: override the default 30-minute polling interval for monitor.ts
# (vacationMonitor.ts's interval is fixed at 15 minutes in code)
PRICE_ALERT_POLL_MINUTES=30

# Optional: override the default port for the local results.ts webpage (default 3000)
PORT=3000
